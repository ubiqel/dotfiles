{
    "include": [
        "base.jsonc"
    ],
    "margin-top": 5,
    "margin-bottom": 5,
    "margin-left": 10,
    "margin-right": 10,
    "height": 20,
    "modules-left": [
        "group/power-group",
        "group/brightness-group"
    ],
    "modules-center": [
        "sway/workspaces"
    ],
    "modules-right": [
        "group/system-indicators",
        "group/tray-group"
    ],
    "group/power-group": {
        "orientation": "horizontal",
        "modules": [
            "custom/poweroff",
            "custom/suspend"
        ]
    },
    "group/brightness-group": {
        "orientation": "horizontal",
        "modules": [
            "custom/monitor2_brightness",
            "custom/monitor1_brightness"
        ]
    },
    "group/system-indicators": {
        "orientation": "horizontal",
        "modules": [
            "inhibitor",
            "custom/darkman",
            "custom/voxtype",
            "pulseaudio",
            "bluetooth",
            "network",
            "clock",
            "sway/language"
        ]
    },
    "group/tray-group": {
        "orientation": "horizontal",
        "modules": [
            "tray"
        ]
    },
    "custom/suspend": {
        "format": "{}",
        "exec": "echo '󰒲'",
        "interval": "once",
        "on-click": "systemctl suspend",
        "tooltip": false
    },
    "custom/poweroff": {
        "format": "{}",
        "exec": "echo ''",
        "interval": "once",
        "on-click": "swaynag -t warning -m 'Power off this PC?' -B 'Yes, shut down' 'systemctl poweroff'",
        "tooltip": false
    },
    "custom/monitor1_brightness": {
        "format": "󰃠 M1: {}%",
        "exec-on-event": false,
        "interval": 5,
        "signal": 8,
        "exec": "monlux get 'edid:GBT:M27Q P:23133B000026'",
        "on-click": "monlux cycle 'edid:GBT:M27Q P:23133B000026' --steps=0,50,100; pkill -SIGRTMIN+8 waybar",
        "on-click-right": "monlux cycle 'edid:GBT:M27Q P:23133B000026' --steps=100,50,0; pkill -SIGRTMIN+8 waybar",
        "on-scroll-up": "monlux up 'edid:GBT:M27Q P:23133B000026' 5; pkill -SIGRTMIN+8 waybar",
        "on-scroll-down": "monlux down 'edid:GBT:M27Q P:23133B000026' 5; pkill -SIGRTMIN+8 waybar",
        "tooltip": false
    },
    "custom/monitor2_brightness": {
        "format": "󰃠 M2: {}%",
        "exec-on-event": false,
        "interval": 5,
        "signal": 9,
        "exec": "monlux get 'edid:XMI:Mi Monitor:7041110045904'",
        "on-click": "monlux cycle 'edid:XMI:Mi Monitor:7041110045904' --steps=0,50,100; pkill -SIGRTMIN+9 waybar",
        "on-click-right": "monlux cycle 'edid:XMI:Mi Monitor:7041110045904' --steps=100,50,0; pkill -SIGRTMIN+9 waybar",
        "on-scroll-up": "monlux up 'edid:XMI:Mi Monitor:7041110045904' 5; pkill -SIGRTMIN+9 waybar",
        "on-scroll-down": "monlux down 'edid:XMI:Mi Monitor:7041110045904' 5; pkill -SIGRTMIN+9 waybar",
        "tooltip": false
    },
    "custom/darkman": {
        "format": "{}",
        "return-type": "json",
        "exec": "if darkman get | grep -q 'dark'; then echo '{\"text\":\"\",\"class\":\"dark\"}'; else echo '{\"text\":\"󰖨\",\"class\":\"light\"}'; fi",
        "on-click": "darkman toggle",
        "interval": 5,
        "tooltip": false
    },
    "custom/voxtype": {
        "exec": "voxtype status --follow --format json",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "idle": "",
            "recording": "●",
            "transcribing": "◐",
            "stopped": "⊘"
        },
        "tooltip": true,
        "on-click": "voxtype-configure-launcher",
        "on-click-right": "systemctl --user restart voxtype"
    },
    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        "on-click": "blueberry"
    }
}
