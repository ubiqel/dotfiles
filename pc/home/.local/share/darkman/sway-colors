#!/bin/sh
# Switch Sway titlebar and border colors with the darkman mode.
#
# Darkman runs this script on every mode change and at startup, passing the
# current mode as $1. When run manually, fall back to querying darkman.

set -eu

mode=${1:-}
if [ -z "$mode" ]; then
    for _ in $(seq 1 50); do
        if mode=$(darkman get 2>/dev/null); then
            break
        fi
        sleep 0.1
    done
fi

case "$mode" in
dark)
    # True neutral grays to blend with browser chrome, with a blue accent.
    focused_bg="#414141"
    focused_fg="#e6e6e6"
    focused_border="#414141"
    focused_child_border="#b8b8b8"
    inactive_bg="#343434"
    inactive_fg="#b8b8b8"
    unfocused_bg="#292929"
    unfocused_fg="#949494"
    urgent_bg="#ed8796"
    urgent_fg="#24273a"
    tab_title_bg="#343434"
    tab_title_fg="#8aadf4"
    ;;
light)
    # Catppuccin Latte, with Waybar's muted accent palette.
    focused_bg="#6371c2"
    focused_fg="#eff1f5"
    focused_border="#6371c2"
    focused_child_border="#4c4f69"
    inactive_bg="#bcc0cc"
    inactive_fg="#4c4f69"
    unfocused_bg="#ccd0da"
    unfocused_fg="#6c6f85"
    urgent_bg="#d20f39"
    urgent_fg="#eff1f5"
    tab_title_bg="#bcc0cc"
    tab_title_fg="#6371c2"
    ;;
*)
    echo "sway-colors: unknown or unavailable mode: ${mode:-<empty>}" >&2
    exit 1
    ;;
esac

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/sway"
cache_file="$cache_dir/theme-colors.conf"
mkdir -p "$cache_dir"

# Keep the colors in a real file so `swaymsg reload` reapplies the active
# theme instead of resetting to Sway's dark defaults.
cat >"$cache_file" <<EOF
# Generated by ~/.local/share/darkman/sway-colors; do not edit.
client.focused $focused_border $focused_bg $focused_fg $focused_border $focused_child_border
client.focused_inactive $inactive_bg $inactive_bg $inactive_fg $inactive_bg $inactive_bg
client.focused_tab_title $tab_title_bg $tab_title_bg $tab_title_fg
client.unfocused $unfocused_bg $unfocused_bg $unfocused_fg $unfocused_bg $unfocused_bg
client.urgent $urgent_bg $urgent_bg $urgent_fg $urgent_bg $urgent_bg
EOF

swaymsg "client.focused $focused_border $focused_bg $focused_fg $focused_border $focused_child_border"
swaymsg "client.focused_inactive $inactive_bg $inactive_bg $inactive_fg $inactive_bg $inactive_bg"
swaymsg "client.focused_tab_title $tab_title_bg $tab_title_bg $tab_title_fg"
swaymsg "client.unfocused $unfocused_bg $unfocused_bg $unfocused_fg $unfocused_bg $unfocused_bg"
swaymsg "client.urgent $urgent_bg $urgent_bg $urgent_fg $urgent_bg $urgent_bg"
