#!/bin/bash
set -uo pipefail

# Control ddcci-backlight devices for Waybar.
# Usage: waybar-ddcci <get|up|down|cycle|cycle-reverse|resolve> <role>
#
# <role> is a stable monitor role (e.g. M1) defined in
# ~/.config/waybar/ddcci-monitors.conf, or a legacy raw device (ddcciN).
# Roles are resolved to the current ddcci bus device on demand, so the Waybar
# config does not need to be rewritten when i2c bus numbers change.

ACTION="${1:-}"
ROLE="${2:-}"
[ -z "$ACTION" ] && exit 1
[ -z "$ROLE" ] && exit 1

MAPPING="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/ddcci-monitors.conf"
CACHEDIR="${XDG_RUNTIME_DIR:-/tmp}/waybar-brightness-cache"
mkdir -p "$CACHEDIR"

# Resolve a monitor role to a ddcci backlight device name.
# Prints the device on success and returns 0; returns 1 if unresolvable.
resolve_role() {
    local role="$1" file dev="" identity line

    # Legacy: raw device name.
    if [[ "$role" =~ ^ddcci[0-9]+$ ]]; then
        if [ -d "/sys/class/backlight/$role" ]; then
            echo "$role"
            return 0
        fi
        return 1
    fi

    # Cached resolution, invalidated when the device disappears.
    file="$CACHEDIR/$role.dev"
    if [ -f "$file" ]; then
        dev="$(cat "$file" 2>/dev/null || true)"
        if [ -n "$dev" ] && [ -d "/sys/class/backlight/$dev" ]; then
            echo "$dev"
            return 0
        fi
    fi

    # Look up the monitor identity for this role.
    [ -f "$MAPPING" ] || return 1
    identity="$(grep -E "^${role}=" "$MAPPING" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    [ -n "$identity" ] || return 1

    command -v ddcutil >/dev/null 2>&1 || return 1

    # Find the display whose Monitor identity matches and derive its device
    # (ddcci device names are ddcci<bus>).
    local raw="" bus="" mon=""
    raw="$(ddcutil detect --brief 2>/dev/null || true)"
    while IFS= read -r line; do
        if [[ "$line" =~ ^Display[[:space:]]+[0-9]+ ]]; then
            if [ "$mon" = "$identity" ] && [ -n "$bus" ]; then
                dev="ddcci${bus}"
                break
            fi
            bus=""
            mon=""
        elif [[ "$line" =~ I2C[[:space:]]bus:[[:space:]]+/dev/i2c-([0-9]+) ]]; then
            bus="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^[[:space:]]*Monitor:[[:space:]]*(.*)$ ]]; then
            mon="${BASH_REMATCH[1]}"
        fi
    done <<<"$raw"
    if [ -z "$dev" ] && [ "$mon" = "$identity" ] && [ -n "$bus" ]; then
        dev="ddcci${bus}"
    fi

    [ -n "$dev" ] || return 1
    [ -d "/sys/class/backlight/$dev" ] || return 1

    echo "$dev" > "$file"
    echo "$dev"
    return 0
}

DEVICE="$(resolve_role "$ROLE" || true)"

if [ "$ACTION" = "resolve" ]; then
    if [ -n "$DEVICE" ]; then
        echo "$DEVICE"
        exit 0
    fi
    exit 1
fi

[ -n "$DEVICE" ] || exit 1

CACHEFILE="$CACHEDIR/$ROLE"

current() {
    timeout 3 brightnessctl -d "$DEVICE" -m info 2>/dev/null | cut -d, -f4 | tr -d '%'
}

apply() {
    brightnessctl -d "$DEVICE" set "$1" >/dev/null
}

cached_or_live() {
    if [ -f "$CACHEFILE" ] && [ "$(($(date +%s) - $(stat -c %Y "$CACHEFILE")))" -lt 2 ]; then
        cat "$CACHEFILE"
    else
        local val
        val="$(current)"
        echo "${val:-$(cat "$CACHEFILE" 2>/dev/null || echo 0)}" | tee "$CACHEFILE"
    fi
}

cycle() {
    local direction="$1"
    cur="$(current)"

    if [ "$direction" -eq 1 ]; then
        presets=(0 50 100)
    else
        presets=(100 50 0)
    fi

    next="${presets[0]}"
    for p in "${presets[@]}"; do
        if [ "$direction" -eq 1 ] && [ "$cur" -lt "$p" ]; then
            next="$p"
            break
        elif [ "$direction" -eq -1 ] && [ "$cur" -gt "$p" ]; then
            next="$p"
            break
        fi
        if [ "$cur" -eq "$p" ]; then
            found=0
            for q in "${presets[@]}"; do
                if [ "$found" -eq 1 ]; then
                    next="$q"
                    break 2
                fi
                [ "$q" -eq "$cur" ] && found=1
            done
            next="${presets[0]}"
            break
        fi
    done

    # Cache expected value before slow DDC/CI write.
    echo "$next" > "$CACHEFILE"
    apply "${next}%"
}

case "$ACTION" in
    get)
        cached_or_live
        ;;
    up)
        cur="$(current)"
        val=$((cur + 5 > 100 ? 100 : cur + 5))
        echo "$val" > "$CACHEFILE"
        apply '+5%'
        ;;
    down)
        cur="$(current)"
        val=$((cur - 5 < 0 ? 0 : cur - 5))
        echo "$val" > "$CACHEFILE"
        apply '5%-'
        ;;
    cycle)
        cycle 1
        ;;
    cycle-reverse)
        cycle -1
        ;;
    *)
        exit 1
        ;;
esac
