#!/bin/bash
set -uo pipefail

# Control ddcci-backlight devices for Waybar.
# Usage: waybar-ddcci <get|up|down|cycle|cycle-reverse> <device>

DEVICE="${2:-}"
[ -z "$DEVICE" ] && exit 1

CACHEDIR="${XDG_RUNTIME_DIR:-/tmp}/waybar-brightness-cache"
mkdir -p "$CACHEDIR"
CACHEFILE="$CACHEDIR/$DEVICE"
LOCKFILE="$CACHEDIR/$DEVICE.lock"

current() {
    timeout 3 brightnessctl -d "$DEVICE" -m info 2>/dev/null | cut -d, -f4 | tr -d '%'
}

apply() {
    brightnessctl -d "$DEVICE" set "$1" >/dev/null
}

cached_or_live() {
    if [ -f "$CACHEFILE" ] && [ "$(($(date +%s) - $(stat -c %Y "$CACHEFILE")))" -lt 2 ]; then
        cat "$CACHEFILE"
    else
        local val
        val="$(current)"
        echo "${val:-$(cat "$CACHEFILE" 2>/dev/null || echo 0)}" | tee "$CACHEFILE"
    fi
}

cycle() {
    local direction="$1"
    cur="$(current)"

    if [ "$direction" -eq 1 ]; then
        presets=(0 50 100)
    else
        presets=(100 50 0)
    fi

    next="${presets[0]}"
    for p in "${presets[@]}"; do
        if [ "$direction" -eq 1 ] && [ "$cur" -lt "$p" ]; then
            next="$p"
            break
        elif [ "$direction" -eq -1 ] && [ "$cur" -gt "$p" ]; then
            next="$p"
            break
        fi
        if [ "$cur" -eq "$p" ]; then
            found=0
            for q in "${presets[@]}"; do
                if [ "$found" -eq 1 ]; then
                    next="$q"
                    break 2
                fi
                [ "$q" -eq "$cur" ] && found=1
            done
            next="${presets[0]}"
            break
        fi
    done

    # Cache expected value before slow DDC/CI write.
    echo "$next" > "$CACHEFILE"
    apply "${next}%"
}

case "$1" in
    get)
        cached_or_live
        ;;
    up)
        cur="$(current)"
        val=$((cur + 5 > 100 ? 100 : cur + 5))
        echo "$val" > "$CACHEFILE"
        apply '+5%'
        ;;
    down)
        cur="$(current)"
        val=$((cur - 5 < 0 ? 0 : cur - 5))
        echo "$val" > "$CACHEFILE"
        apply '5%-'
        ;;
    cycle)
        cycle 1
        ;;
    cycle-reverse)
        cycle -1
        ;;
    *)
        exit 1
        ;;
esac
