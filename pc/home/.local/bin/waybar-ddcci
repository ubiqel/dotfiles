#!/bin/bash
set -uo pipefail

# Control monitor brightness for Waybar.
# Usage: waybar-ddcci <get|up|down|cycle|cycle-reverse|resolve> <role>
#
# <role> is a stable monitor role (e.g. M1) defined in
# ~/.config/waybar/ddcci-monitors.conf, or a legacy raw device (ddcciN).
#
# Each role resolves to a target:
#   ddcciN  - the ddcci-backlight kernel device (fast path)
#   bus:N   - ddcutil fallback on I2C bus N. Used when the kernel driver failed
#             to bind (e.g. the monitor returns a malformed DDC/CI capability
#             string, leaving a stale core device). ddcutil still works.
# The target is re-resolved automatically when it disappears, and a ddcutil
# fallback is upgraded to the kernel device if that device later appears.

ACTION="${1:-}"
ROLE="${2:-}"
[ -z "$ACTION" ] && exit 1
[ -z "$ROLE" ] && exit 1

MAPPING="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/ddcci-monitors.conf"
CACHEDIR="${XDG_RUNTIME_DIR:-/tmp}/waybar-brightness-cache"
mkdir -p "$CACHEDIR"

# Look up a role's EDID identity and derive its target.
# Prints "ddcciN" or "bus:N"; returns 1 if it cannot be found.
lookup_role_target() {
    local role="$1" identity raw bus mon line

    [ -f "$MAPPING" ] || return 1
    identity="$(grep -E "^${role}=" "$MAPPING" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    [ -n "$identity" ] || return 1

    command -v ddcutil >/dev/null 2>&1 || return 1

    raw="$(ddcutil detect --brief --disable-dynamic-sleep 2>/dev/null || true)"
    bus=""
    mon=""
    while IFS= read -r line; do
        if [[ "$line" =~ ^Display[[:space:]]+[0-9]+ ]]; then
            if [ "$mon" = "$identity" ] && [ -n "$bus" ]; then
                break
            fi
            bus=""
            mon=""
        elif [[ "$line" =~ I2C[[:space:]]bus:[[:space:]]+/dev/i2c-([0-9]+) ]]; then
            bus="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^[[:space:]]*Monitor:[[:space:]]*(.*)$ ]]; then
            mon="${BASH_REMATCH[1]}"
        fi
    done <<<"$raw"

    if [ "$mon" = "$identity" ] && [ -n "$bus" ]; then
        if [ -d "/sys/class/backlight/ddcci${bus}" ]; then
            echo "ddcci${bus}"
        else
            echo "bus:${bus}"
        fi
        return 0
    fi
    return 1
}

# Resolve a role to a target, with positive/negative caching.
resolve_target() {
    local role="$1" file cache missfile last now ttl bus

    # Legacy: raw device name.
    if [[ "$role" =~ ^ddcci[0-9]+$ ]]; then
        if [ -d "/sys/class/backlight/$role" ]; then
            echo "$role"
            return 0
        fi
        return 1
    fi

    file="$CACHEDIR/$role.target"
    if [ -f "$file" ]; then
        cache="$(cat "$file" 2>/dev/null || true)"
        if [[ "$cache" == bus:* ]]; then
            bus="${cache#bus:}"
            # Prefer the kernel device once it appears.
            if [ -d "/sys/class/backlight/ddcci${bus}" ]; then
                echo "ddcci${bus}" > "$file"
                echo "ddcci${bus}"
                return 0
            fi
            if [ -d "/sys/bus/i2c/devices/i2c-${bus}" ]; then
                echo "$cache"
                return 0
            fi
        elif [ -n "$cache" ] && [ -d "/sys/class/backlight/$cache" ]; then
            echo "$cache"
            return 0
        fi
    fi

    # Throttle repeated misses so Waybar polling does not spam ddcutil (which
    # contends with ddcci-setup for the i2c bus locks) while a target is
    # missing. DDCCI_MISS_TTL=0 disables throttling (used by verify-mapping).
    missfile="$CACHEDIR/$role.miss"
    if [ "${DDCCI_MISS_TTL:-15}" -gt 0 ] && [ -f "$missfile" ]; then
        last="$(cat "$missfile" 2>/dev/null || echo 0)"
        now="$(date +%s)"
        ttl="${DDCCI_MISS_TTL:-15}"
        if [ $((now - last)) -lt "$ttl" ]; then
            return 1
        fi
    fi

    cache="$(lookup_role_target "$role" || true)"
    if [ -n "$cache" ]; then
        rm -f "$missfile"
        echo "$cache" > "$file"
        echo "$cache"
        return 0
    fi

    date +%s > "$missfile" 2>/dev/null || true
    return 1
}

TARGET="$(resolve_target "$ROLE" || true)"

if [ "$ACTION" = "resolve" ]; then
    if [ -n "$TARGET" ]; then
        echo "$TARGET"
        exit 0
    fi
    exit 1
fi

[ -n "$TARGET" ] || exit 1

CACHEFILE="$CACHEDIR/$ROLE"
MAXFILE="$CACHEDIR/$ROLE.max"

bus_number() { echo "${TARGET#bus:}"; }

# Read the current brightness percentage. Also refreshes the max value for
# ddcutil targets.
current() {
    local cur max out
    case "$TARGET" in
        bus:*)
            out="$(timeout 5 ddcutil --bus "$(bus_number)" --disable-dynamic-sleep getvcp 10 --brief 2>/dev/null | awk '{print $4, $5}')"
            cur="${out%% *}"
            max="${out##* }"
            if [ -n "$cur" ] && [ -n "$max" ] && [ "$max" -gt 0 ] 2>/dev/null; then
                echo "$max" > "$MAXFILE"
                echo $(( cur * 100 / max ))
            fi
            ;;
        *)
            timeout 3 brightnessctl -d "$TARGET" -m info 2>/dev/null | cut -d, -f4 | tr -d '%'
            ;;
    esac
}

# Current brightness, falling back to the last cached value.
current_or_cached() {
    local c
    c="$(current)"
    if [ -z "$c" ]; then
        c="$(cat "$CACHEFILE" 2>/dev/null || echo 0)"
    fi
    echo "$c"
}

# Set brightness to an absolute percentage.
apply() {
    local pct="$1" max val
    case "$TARGET" in
        bus:*)
            if [ ! -f "$MAXFILE" ]; then
                current >/dev/null 2>&1 || true
            fi
            max="$(cat "$MAXFILE" 2>/dev/null || echo 100)"
            if ! [ "$max" -gt 0 ] 2>/dev/null; then
                max=100
            fi
            val=$(( pct * max / 100 ))
            [ "$val" -gt "$max" ] && val="$max"
            [ "$val" -lt 0 ] && val=0
            timeout 5 ddcutil --bus "$(bus_number)" --disable-dynamic-sleep setvcp 10 "$val" >/dev/null 2>&1
            ;;
        *)
            brightnessctl -d "$TARGET" set "${pct}%" >/dev/null
            ;;
    esac
}

cached_or_live() {
    if [ -f "$CACHEFILE" ] && [ "$(($(date +%s) - $(stat -c %Y "$CACHEFILE")))" -lt 2 ]; then
        cat "$CACHEFILE"
    else
        local val
        val="$(current)"
        echo "${val:-$(cat "$CACHEFILE" 2>/dev/null || echo 0)}" | tee "$CACHEFILE"
    fi
}

cycle() {
    local direction="$1"
    cur="$(current_or_cached)"

    if [ "$direction" -eq 1 ]; then
        presets=(0 50 100)
    else
        presets=(100 50 0)
    fi

    next="${presets[0]}"
    for p in "${presets[@]}"; do
        if [ "$direction" -eq 1 ] && [ "$cur" -lt "$p" ]; then
            next="$p"
            break
        elif [ "$direction" -eq -1 ] && [ "$cur" -gt "$p" ]; then
            next="$p"
            break
        fi
        if [ "$cur" -eq "$p" ]; then
            found=0
            for q in "${presets[@]}"; do
                if [ "$found" -eq 1 ]; then
                    next="$q"
                    break 2
                fi
                [ "$q" -eq "$cur" ] && found=1
            done
            next="${presets[0]}"
            break
        fi
    done

    # Cache expected value before the slow DDC/CI write.
    echo "$next" > "$CACHEFILE"
    apply "$next"
}

case "$ACTION" in
    get)
        cached_or_live
        ;;
    up)
        cur="$(current_or_cached)"
        val=$((cur + 5 > 100 ? 100 : cur + 5))
        echo "$val" > "$CACHEFILE"
        apply "$val"
        ;;
    down)
        cur="$(current_or_cached)"
        val=$((cur - 5 < 0 ? 0 : cur - 5))
        echo "$val" > "$CACHEFILE"
        apply "$val"
        ;;
    cycle)
        cycle 1
        ;;
    cycle-reverse)
        cycle -1
        ;;
    *)
        exit 1
        ;;
esac
