{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "cobalt2"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "verbosity": "medium"
  },
  "animations": true,
  "prompt": {
    "editor": false,
    "image_preview": true
  },
  "debug": {
    "devtools": false
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "tabs": {
    "indicators": "status"
  },
  "plugins": [
    "opencode-sidebar-token-metrics"
  ]
}
