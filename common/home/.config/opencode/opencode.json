{
  "$schema": "https://opencode.ai/config.json",
  "commands": {},
  "compaction": {
    "auto": true
  },
  "worktree": {
    "directory": ".lane/trees"
  },
  "watcher": {
    "ignore": [".lane/**"]
  },
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "/home/salkirr/.local/bin/browse",
          "mcp"
        ],
        "cwd": "~",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
