{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash#high"
    }
  },
  "session": {
    "permissions": "autoaccept"
  },
  "compaction": {
    "auto": true
  },
  "worktree": {
    "directory": ".lane/trees"
  },
  "watcher": {
    "ignore": [".lane/**"]
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "/bin/sh",
          "-c",
          "exec \"$HOME/.local/bin/browse\" mcp"
        ],
        "cwd": "~",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
