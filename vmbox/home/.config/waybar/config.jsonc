{
    "include": [
        "base.jsonc"
    ],
    "modules-left": [
        "group/power-group"
    ],
    "modules-center": [
        "sway/workspaces"
    ],
    "modules-right": [
        "group/system-indicators",
        "group/tray-group"
    ],
    "group/power-group": {
        "orientation": "horizontal",
        "modules": [
            "custom/poweroff",
            "custom/suspend"
        ]
    },
    "group/system-indicators": {
        "orientation": "horizontal",
        "modules": [
            "inhibitor",
            "custom/darkman",
            "pulseaudio",
            "network",
            "clock",
            "sway/language"
        ]
    },
    "pulseaudio": {
        "on-click": "pavucontrol"
    }
}
