[Unit]
Description=Re-probe ddcci devices after resume
After=suspend.target hibernate.target hybrid-sleep.target

[Service]
Type=oneshot
# ddcutil 3.x aborts initialization without a usable HOME (dynamic-sleep cache).
Environment=HOME=/root
ExecStart=/usr/local/bin/ddcci-setup

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target
