[Unit]
Description=Probe ddcci devices on display I2C buses
After=graphical.target systemd-modules-load.service
Wants=systemd-modules-load.service
# Some monitors need time to become DDC/CI-ready after boot, so retry transient
# probe failures for a while (up to 20 starts / 30 minutes).
StartLimitIntervalSec=1800
StartLimitBurst=20

[Service]
Type=oneshot
# ddcutil 3.x aborts initialization without a usable HOME (dynamic-sleep cache).
Environment=HOME=/root
# Restart on failure until the backlight devices are created; a clean exit (all
# devices bound) does not restart.
Restart=on-failure
RestartSec=20
ExecStart=/usr/local/bin/ddcci-setup
