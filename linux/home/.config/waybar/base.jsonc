{
    "margin-top": 5,
    "margin-bottom": 5,
    "margin-left": 10,
    "margin-right": 10,
    "height": 20,
    "sway/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {},
        "sort-by-number": true
    },
    "sway/language": {
        "format": "{}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
        "hide-single-layout": false
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "network": {
        "format": "{ifname}",
        "format-wifi": "{signalStrength}% ",
        "format-ethernet": "{ipaddr}/{cidr} 󰊗",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": " ⚠",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid}",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": " {icon}",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "scroll-step": 2
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8,
        "show-passive-items": false,
        "format": "{icon}"
    },
    "inhibitor": {
        "what": [
            "idle",
            "sleep",
            "shutdown"
        ],
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "group/tray-group": {
        "orientation": "horizontal",
        "modules": [
            "tray"
        ]
    },
    "custom/poweroff": {
        "format": "{}",
        "exec": "echo ''",
        "interval": "once",
        "on-click": "swaynag -t warning -m 'Power off this machine?' -B 'Yes, shut down' 'systemctl poweroff'",
        "tooltip": false
    }
}
